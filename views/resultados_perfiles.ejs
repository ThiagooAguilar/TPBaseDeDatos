<!DOCTYPE html>
<html lang="es">
<head>
    <title>Resultados de Búsqueda</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@3.2.0/dist/full.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
</head>
<body class="bg-[#111] text-white font-['Roboto'] min-h-screen">

<div class="navbar bg-[#222] shadow-lg sticky top-0 z-50 mb-6">
    <div class="flex-1">
        <a href="/" class="btn btn-ghost normal-case text-2xl text-[#7F00FF]">🎬 CineApp</a>
    </div>
    <div class="flex-none gap-2">
        <form action="/buscar" method="GET" class="form-control hidden md:block">
            <input type="text" name="q" placeholder="Buscar películas..." class="input input-bordered input-sm bg-[#333] text-white w-64" />
        </form>
        <% if (userId) { %>
            <div class="dropdown dropdown-end">
                <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                    <div class="w-10 rounded-full bg-[#7F00FF] flex items-center justify-center">
                        <span class="text-white font-bold">U</span>
                    </div>
                </label>
                <ul tabindex="0" class="mt-3 z-[1] p-2 shadow menu menu-sm dropdown-content bg-[#222] rounded-box w-52">
                    <li><a href="/perfil/<%= userId %>" class="text-white hover:bg-[#7F00FF]">👤 Mi Perfil</a></li>
                    <li><a href="/logout" class="text-white hover:bg-error">🚪 Cerrar Sesión</a></li>
                </ul>
            </div>
        <% } else { %>
            <a href="/login" class="btn btn-primary bg-[#7F00FF] border-0">Iniciar Sesión</a>
            <a href="/register" class="btn btn-outline btn-primary">Registrarse</a>
        <% } %>
    </div>
</div>

<div class="container mx-auto p-6 max-w-4xl">
    <h1 class="text-4xl font-bold mb-8 text-white">
        Resultados para "<%= query %>"
    </h1>

    <div class="mb-6">
        <a href="/search_profile" class="btn btn-sm btn-ghost text-gray-400">← Nueva Búsqueda de Perfil</a>
    </div>

    <% if (users.length === 0) { %>
        <div class="alert alert-warning shadow-lg">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <span>No se encontraron perfiles que coincidan con la búsqueda.</span>
            </div>
        </div>
    <% } else { %>
        <h2 class="text-2xl font-semibold text-gray-300 mb-4">Perfiles de Usuario (<%= users.length %>)</h2>

        <div class="space-y-4">
            <% users.forEach(user => { %>
                <div class="card bg-[#222] shadow-xl p-5 hover:bg-[#333] transition duration-200">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div class="avatar placeholder">
                                <div class="bg-[#7F00FF] text-white rounded-full w-12">
                                    <span class="text-xl"><%= user.user_name.charAt(0).toUpperCase() %></span>
                                </div>
                            </div>
                            <div>
                                <p class="text-xl font-bold text-[#7F00FF]"><%= user.user_name %></p>
                                <p class="text-gray-400 text-sm">@<%= user.user_username %></p>
                            </div>
                        </div>
                        <a href="/perfil/<%= user.user_id %>" class="btn btn-sm bg-[#7F00FF] border-0 hover:bg-[#5800BB]">
                            Ver Perfil
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

</body>
</html>