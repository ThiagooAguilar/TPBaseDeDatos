<!DOCTYPE html>
<html lang="es">
<head>
    <title>Iniciar Sesión - MovieWeb</title>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@3.2.0/dist/full.css" rel="stylesheet">

    <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-[#111] text-white font-['Roboto']">

<div class="auth-container">
    <div class="auth-card">
        <h2>🔑 Iniciar Sesión</h2>

        <% if (locals.error) { %>
            <div class="message error"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="identifier">Usuario o Correo Electrónico:</label>
                <input type="text" id="identifier" name="identifier" required>
            </div>
            <div class="form-group">
                <label for="password">Contraseña:</label>
                <input type="password" id="password" name="user_password" required>
            </div>
            <button type="submit" class="btn primary">Ingresar</button>
        </form>

        <div class="auth-footer">
            ¿No tienes una cuenta? <a href="/register">Regístrate Aquí</a>
        </div>
    </div>
</div>

</body>
</html>