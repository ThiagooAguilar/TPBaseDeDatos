<!DOCTYPE html>
<html lang="es">
<head>
    <title><%= movie.title %></title>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@3.2.0/dist/full.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">

    <style>
        /* Estilo para el ancho fijo de las tarjetas de personas */
        .person-card {
            width: 140px; /* Ancho para las tarjetas de elenco/crew */
            height: auto;
        }
    </style>
</head>
<body class="bg-[#111] text-white font-['Roboto'] p-6">
<!-- Agregar este navbar al inicio de tus páginas (index.ejs, pelicula.ejs, etc.) -->
<div class="navbar bg-[#222] shadow-lg sticky top-0 z-50 mb-6">
    <div class="flex-1">
        <a href="/" class="btn btn-ghost normal-case text-2xl text-[#7F00FF]">
            🎬 CineApp
        </a>
    </div>

    <div class="flex-none gap-2">
        <!-- Buscador -->
        <form action="/buscar" method="GET" class="form-control hidden md:block">
            <input type="text"
                   name="q"
                   placeholder="Buscar películas..."
                   class="input input-bordered input-sm bg-[#333] text-white w-64" />
        </form>

        <% if (locals.current_user_id) { %>
            <!-- Usuario logueado -->
            <div class="dropdown dropdown-end">
                <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                    <div class="w-10 rounded-full bg-[#7F00FF] flex items-center justify-center">
                        <span class="text-white font-bold">U</span>
                    </div>
                </label>
                <ul tabindex="0" class="mt-3 z-[1] p-2 shadow menu menu-sm dropdown-content bg-[#222] rounded-box w-52">
                    <li><a href="/perfil" class="text-white hover:bg-[#7F00FF]">👤 Mi Perfil</a></li>
                    <li><a href="/logout" class="text-white hover:bg-error">🚪 Cerrar Sesión</a></li>
                </ul>
            </div>
        <% } else { %>
            <!-- Usuario NO logueado -->
            <a href="/login" class="btn btn-primary bg-[#7F00FF] border-0">Iniciar Sesión</a>
            <a href="/register" class="btn btn-outline btn-primary">Registrarse</a>
        <% } %>
    </div>
</div>

<%
// --- LÓGICA PARA FORMATEAR LA FECHA (SE MANTIENE) ---
const monthNames = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
const date = new Date(movie.release_date);
const day = date.getDate();
const month = monthNames[date.getMonth()];
const year = date.getFullYear();
const formattedDate = `${day}-${month}-${year}`;

// --- VARIABLES NECESARIAS (ASEGÚRATE DE PASAR ESTAS DESDE EL BACKEND) ---
// Simulación de datos (DEBE SER REEMPLAZADO POR DATOS REALES DEL BACKEND)
const current_user_id = locals.current_user_id || '123'; // ID del usuario logueado
const movie_user_data = locals.movie_user_data || {
    rating: null,
    opinion: '',
    favorite: false
}; // Datos de la tabla movie_user para este usuario/película
%>

<div class="flex flex-col md:flex-row gap-8 mb-10">
    <div class="flex-shrink-0 w-full md:w-64 max-w-sm mx-auto md:mx-0">
        <img src="<%= movie.poster_url %>"
             alt="Póster de <%= movie.title %>"
             class="rounded-lg shadow-2xl w-full object-cover"
             onerror="this.onerror=null;this.src='https://placehold.co/300x450/222/ffffff?text=Póster+No+Disp.'" />
    </div>

    <div class="flex-grow">
        <h1 class="text-5xl text-[#7F00FF] font-extrabold mb-3"><%= movie.title %></h1>

        <% if (movie.vote_average) { %>
            <div class="badge badge-warning text-lg font-bold mb-4 p-3">
                ⭐ <%= Number(movie.vote_average).toFixed(1) %>
            </div>
        <% } %>

        <p class="text-lg mb-4"><strong>Fecha de Estreno:</strong> <%= formattedDate %></p>

        <h3 class="text-3xl text-white mt-8 mb-3">Argumento</h3>
        <div id="overview" class="text-gray-300 leading-relaxed">
            <p><%= movie.overview %></p>
        </div>
    </div>
</div>

<% const renderPersonCarousel = (people, title, linkPrefix, roleLabel, roleClass) => { %>
    <h2 class="text-3xl text-white my-6 ml-4"><%= title %></h2>
    <% if (people.length === 0) { %>
        <p class="ml-4">No se encontraron <%= title.toLowerCase() %>.</p>
    <% } else { %>
        <div class="flex flex-row overflow-x-auto gap-4 px-4 pb-6">
            <% people.forEach((person) => { %>
                <a href="<%= linkPrefix %>/<%= person.actor_id || person.crew_member_id %>"
                   class="hover:scale-[1.05] transition duration-300 transform flex-shrink-0"
                   title="<%= person.actor_name || person.crew_member_name %>">
                    <div class="card bg-[#222] person-card shadow-md">
                        <figure class="h-40">
                            <img src="<%= person.profile_url %>"
                                 alt="<%= person.actor_name || person.crew_member_name %>"
                                 class="h-full w-full object-cover rounded-t-lg"
                                 onerror="this.onerror=null;this.src='https://placehold.co/140x210/222/ffffff?text=Perfil+No+Disp.'" />
                        </figure>
                        <div class="card-body p-3 flex flex-col justify-between">
                            <h4 class="card-title text-white text-sm truncate" title="<%= person.actor_name || person.crew_member_name %>">
                                <%= person.actor_name || person.crew_member_name %>
                            </h4>
                            <% if (roleLabel) { %>
                                <div class="badge <%= roleClass %> text-xs font-bold mt-1">
                                    <%= roleLabel %>
                                </div>
                            <% } %>
                            <% if (person.character_name) { %>
                                <p class="text-gray-400 text-xs mt-1 truncate" title="<%= person.character_name %>">
                                    como <%= person.character_name %>
                                </p>
                            <% } %>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>
<% } %>

<% renderPersonCarousel(movie.directors, 'Directores', '/director', 'Director', 'badge-error') %>

<% renderPersonCarousel(movie.writers, 'Escritores', '/writer', 'Escritor', 'badge-info') %>

<%
// Ordenamos el elenco antes de pasarlo al carrusel
const orderedCast = movie.cast.sort((a, b) => a.cast_order - b.cast_order);
%>
<% renderPersonCarousel(orderedCast, 'Elenco', '/actor', null, null) %>


<h3 class="text-3xl text-white my-6 ml-4">Equipo técnico</h3>
<% if (movie.crew.length === 0) { %>
    <p class="ml-4">No se encontró más equipo técnico.</p>
<% } else { %>
    <div class="ml-4 pb-6">
        <ul class="list-disc list-inside space-y-2 text-gray-300">
            <% movie.crew.forEach((crewMember) => { %>
                <li>
                    <span class="text-white font-semibold"><%= crewMember.crew_member_name %></span> -
                    <%= crewMember.department_name %> (<span class="text-[#7F00FF]"><%= crewMember.job %></span>)
                </li>
            <% }); %>
        </ul>
    </div>
<% } %>

<div class="divider"></div>

<!-- ⭐ SECCIÓN CORREGIDA: TU PUNTUACIÓN Y OPINIÓN -->
<div class="ml-4 pb-6">
    <h3 class="text-3xl text-white mt-8 mb-4">🎬 Tu Puntuación y Opinión</h3>

    <div class="p-6 bg-[#222] rounded-lg shadow-xl border border-gray-700 max-w-4xl mx-auto">
        <form id="interaction-form" onsubmit="handleInteraction(event)">
            <!-- ⭐ CORRECCIÓN: Usar movie.movie_id -->
            <input type="hidden" id="user_id" name="user_id" value="<%= current_user_id %>">
            <input type="hidden" id="movie_id" name="movie_id" value="<%= movie.movie_id %>">

            <div class="flex flex-col sm:flex-row items-center justify-between mb-6 gap-4">
                <div class="form-control w-full sm:w-1/3">
                    <label class="label">
                        <span class="label-text text-white font-bold">Tu Puntuación (1-10):</span>
                    </label>
                    <input type="number" id="rating" name="rating" min="1" max="10" step="0.1" placeholder="Ej: 8.5"
                           value="<%= movie_user_data.rating || '' %>"
                           class="input input-bordered input-sm bg-[#333] border-[#7F00FF] w-full text-white" />
                </div>

                <div class="tooltip tooltip-bottom mt-6 sm:mt-0" data-tip="Añadir/Quitar de Favoritos">
                    <button type="button" id="favorite-btn"
                            class="btn btn-lg w-full sm:w-auto <%= movie_user_data.favorite ? 'btn-error' : 'btn-outline btn-warning' %> transition duration-200">
                        <span id="favorite-text"><%= movie_user_data.favorite ? '❤️ Favorita' : '🤍 Añadir a Favs' %></span>
                    </button>
                </div>
            </div>

            <div class="form-control mb-6">
                <label class="label">
                    <span class="label-text text-white font-bold">Tu Opinión/Reseña:</span>
                </label>
                <textarea id="opinion" name="opinion" placeholder="Escribe tu reseña sobre esta película..."
                          class="textarea textarea-bordered h-32 bg-[#333] border-[#7F00FF] text-white"><%= movie_user_data.opinion || '' %></textarea>
            </div>

            <button type="submit" class="btn btn-block bg-[#7F00FF] border-0 hover:bg-[#9933FF] text-white font-bold">
                💾 Guardar Puntuación y Opinión
            </button>
            <div id="save-message" class="mt-3 text-center text-sm font-bold hidden"></div>
        </form>
    </div>
</div>

<!-- ⭐ SCRIPT CORREGIDO Y LIMPIO -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const saveMessage = document.getElementById('save-message');
        const favoriteBtn = document.getElementById('favorite-btn');
        const favoriteText = document.getElementById('favorite-text');

        // --- Función para manejar el Rating y Opinión ---
        window.handleInteraction = async function(event) {
            event.preventDefault();

            const userId = document.getElementById('user_id').value;
            const movieId = document.getElementById('movie_id').value;
            const rating = document.getElementById('rating').value;
            const opinion = document.getElementById('opinion').value;

            // Validación básica
            if (!userId || !movieId) {
                saveMessage.textContent = '❌ Error: Falta información del usuario o película.';
                saveMessage.classList.remove('hidden', 'text-success');
                saveMessage.classList.add('text-error');
                return;
            }

            // Limpiar el mensaje previo
            saveMessage.classList.add('hidden');
            saveMessage.classList.remove('text-success', 'text-error');

            const data = {
                user_id: parseInt(userId),
                movie_id: parseInt(movieId),
                rating: rating ? parseFloat(rating) : null,
                opinion: opinion.trim() || null,
            };

            try {
                const response = await fetch('/api/movie-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    saveMessage.textContent = '✅ Puntuación y Opinión guardadas correctamente.';
                    saveMessage.classList.remove('hidden');
                    saveMessage.classList.add('text-success');
                } else {
                    const errorData = await response.json();
                    saveMessage.textContent = `❌ Error: ${errorData.error || 'Error desconocido'}`;
                    saveMessage.classList.remove('hidden');
                    saveMessage.classList.add('text-error');
                }
            } catch (error) {
                console.error('Error de red:', error);
                saveMessage.textContent = '❌ Error de conexión. Verifica tu conexión a internet.';
                saveMessage.classList.remove('hidden');
                saveMessage.classList.add('text-error');
            }

            setTimeout(() => saveMessage.classList.add('hidden'), 5000);
        }

        // --- Función para manejar el Favorito (Toggle) ---
        favoriteBtn.addEventListener('click', async () => {
            const isFavorite = favoriteBtn.classList.contains('btn-error');
            const newFavoriteState = !isFavorite;

            const userId = document.getElementById('user_id').value;
            const movieId = document.getElementById('movie_id').value;

            if (!userId || !movieId) {
                alert('❌ Error: Falta información del usuario o película.');
                return;
            }

            const data = {
                user_id: parseInt(userId),
                movie_id: parseInt(movieId),
                favorite: newFavoriteState
            };

            try {
                const response = await fetch('/api/movie-user/favorite', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    // Alternar las clases y el texto visualmente
                    favoriteBtn.classList.toggle('btn-error');
                    favoriteBtn.classList.toggle('btn-outline');
                    favoriteBtn.classList.toggle('btn-warning');

                    if (newFavoriteState) {
                        favoriteText.textContent = '❤️ Favorita';
                    } else {
                        favoriteText.textContent = '🤍 Añadir a Favs';
                    }
                } else {
                    const errorData = await response.json();
                    alert(`❌ Error: ${errorData.error || 'Error al actualizar favoritos'}`);
                }
            } catch (error) {
                console.error('Error de red:', error);
                alert('❌ Error de conexión. Inténtalo de nuevo.');
            }
        });
    });
</script>

<div id="inicio" class="mt-6 ml-4 pb-10">
    <a href="/" class="btn btn-primary bg-[#7F00FF] border-0 hover:bg-[#9933FF]">🏠 Inicio</a>
</div>

</body>
</html>