
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MovieWeb</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@3.2.0/dist/full.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/styles.css">

    <style>
        /* Estilo para ocultar la barra de desplazamiento en el carrusel, si es necesario */
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
        /* El ancho de la tarjeta es ahora fijo y más pequeño */
        .movie-card {
            width: 180px; /* Ancho fijo para pantallas medianas/grandes */
        }
        /* Estilo para el encabezado con el logo (si el logo.png existe) */
        .header-wrapper {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            color: white;
        }
        .header-wrapper h1 {
            font-size: 2.5rem;
            font-weight: bold;
            margin-right: 15px;
        }
        .logo {
            height: 50px; /* Ajusta el tamaño del logo */
        }
        .search-form {
            display: flex;
            width: 100%;
            max-width: 500px;
            margin-bottom: 30px;
        }
        .search-form input {
            flex-grow: 1;
            padding: 10px;
            border-radius: 6px 0 0 6px;
            border: 1px solid #333;
            background-color: #1a1a1a;
            color: white;
        }
        .search-form button {
            padding: 10px 20px;
            border-radius: 0 6px 6px 0;
            background-color: #7F00FF;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>

<div class="drawer drawer-mobile">
    <input id="my-drawer-1" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content flex flex-col items-center p-4">

        <div class="header-wrapper">
            <h1>MovieWeb</h1>
            <img src="/logo.png" class="logo" alt="logo" onerror="this.onerror=null; this.src='https://placehold.co/50x50/7F00FF/ffffff?text=MW'">
        </div>

        <form action="/buscar" method="GET" class="search-form">
            <input type="text" name="q" placeholder="Buscar películas, actores o directores..." />
            <button type="submit">Buscar</button>
        </form>

        <div class="navbar bg-[#222] shadow-lg sticky top-0 z-50 mb-6">
            <div class="flex-1">
                <a href="/" class="btn btn-ghost normal-case text-2xl text-[#7F00FF]">
                    🎬 CineApp
                </a>
            </div>

            <div class="flex-none gap-2">
                <form action="/buscar" method="GET" class="form-control hidden md:block">
                    <input type="text"
                           name="q"
                           placeholder="Buscar películas..."
                           class="input input-bordered input-sm bg-[#333] text-white w-64" />
                </form>

                <% if (userId) { %>
                    <div class="dropdown dropdown-end">
                        <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                            <div class="w-10 rounded-full bg-[#7F00FF] flex items-center justify-center">
                                <span class="text-white font-bold">U</span>
                            </div>
                        </label>
                        <ul tabindex="0" class="mt-3 z-[1] p-2 shadow menu menu-sm dropdown-content bg-[#222] rounded-box w-52">
                            <li><a href="/perfil" class="text-white hover:bg-[#7F00FF]">👤 Mi Perfil</a></li>
                            <li><a href="/logout" class="text-white hover:bg-error">🚪 Cerrar Sesión</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn btn-primary bg-[#7F00FF] border-0">Iniciar Sesión</a>
                    <a href="/register" class="btn btn-outline btn-primary">Registrarse</a>
                <% } %>
            </div>
        </div>

        <div class="mb-8 flex justify-center w-full">
            <a href="/search_keyword">
                <button class="btn btn-sm bg-[#3742fa] text-white hover:bg-[#2029bd] border-none">
                    Buscar por palabra clave
                </button>
            </a>
        </div>
        <div class="mb-8 flex justify-center w-full">
            <a href="/search_profile">
                <button class="btn btn-sm bg-[#3742fa] text-white hover:bg-[#2029bd] border-none">
                    Buscar perfil
                </button>
            </a>
        </div>
        <div id="contenido-principal" class="w-full max-w-7xl">

            <div class="tabs tabs-boxed mb-6 justify-center bg-gray-900">
                <a id="tab-trending" class="tab tab-lg text-[#7F00FF] tab-active">En Tendencia</a>
                <a id="tab-toprated" class="tab tab-lg text-white">Mejor Calificadas</a>
                <a id="tab-upcoming" class="tab tab-lg text-white">Próximos Estrenos</a>
            </div>

            <div id="section-trending">
                <h2 class="text-3xl text-white font-bold mb-4 ml-2 border-l-4 border-[#7F00FF] pl-3">🔥 Películas en Tendencia</h2>

                <% if (trendingMovies && trendingMovies.length > 0) { %>
                    <div class="flex overflow-x-auto space-x-4 pb-4 scrollbar-hide">
                        <% trendingMovies.forEach((movie) => { %>
                            <a href="/pelicula/<%= movie.movie_id %>">
                                <div class="card bg-[#222] movie-card shadow-xl flex-shrink-0 hover:scale-[1.05] transition duration-300 transform">
                                    <figure class="h-64">
                                        <img src="<%= movie.poster_url %>"
                                             alt="<%= movie.title %>"
                                             class="h-full w-full object-cover rounded-t-lg"
                                             onerror="this.onerror=null;this.src='https://placehold.co/180x270/222/ffffff?text=<%= movie.title.substring(0, 10) %>'" />
                                    </figure>
                                    <div class="card-body p-3">
                                        <h2 class="card-title text-white text-base truncate"><%= movie.title %></h2>
                                        <div class="badge badge-warning text-xs font-bold">⭐ <%= movie.vote_average ? Number(movie.vote_average).toFixed(1) : 'N/A' %></div>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="ml-2 text-gray-400">Cargando o no hay datos de películas en tendencia.</p>
                <% } %>
            </div>


            <div id="section-toprated" class="hidden">
                <h2 class="text-3xl text-white font-bold mb-4 ml-2 border-l-4 border-[#7F00FF] pl-3">🌟 Mejor Calificadas</h2>

                <% if (topRatedMovies && topRatedMovies.length > 0) { %>
                    <div class="flex overflow-x-auto space-x-4 pb-4 scrollbar-hide">
                        <% topRatedMovies.forEach((movie) => { %>
                            <a href="/pelicula/<%= movie.movie_id %>">
                                <div class="card bg-[#222] movie-card shadow-xl flex-shrink-0 hover:scale-[1.05] transition duration-300 transform">
                                    <figure class="h-64">
                                        <img src="<%= movie.poster_url %>"
                                             alt="<%= movie.title %>"
                                             class="h-full w-full object-cover rounded-t-lg"
                                             onerror="this.onerror=null;this.src='https://placehold.co/180x270/222/ffffff?text=<%= movie.title.substring(0, 10) %>'" />
                                    </figure>
                                    <div class="card-body p-3">
                                        <h2 class="card-title text-white text-base truncate"><%= movie.title %></h2>
                                        <div class="badge badge-warning text-xs font-bold">⭐ <%= movie.vote_average ? Number(movie.vote_average).toFixed(1) : 'N/A' %></div>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="ml-2 text-gray-400">Cargando o no hay datos de películas mejor calificadas.</p>
                <% } %>
            </div>

            <div id="section-upcoming" class="hidden">
                <h2 class="text-3xl text-white font-bold mb-4 ml-2 border-l-4 border-[#7F00FF] pl-3">📅 Próximos Estrenos</h2>
                <p class="ml-2 text-gray-400">Esta sección aún no está implementada en el servidor.</p>
            </div>
        </div>
    </div>


    <div class="drawer-side">
        <label for="my-drawer-1" class="drawer-overlay"></label>
        <ul class="menu min-h-full w-80 p-4 bg-black text-white">
            <li><a href="/" class="text-lg font-bold hover:text-[#7F00FF]">Inicio</a></li>
            <li><a href="#" class="hover:text-[#7F00FF]">Películas</a></li>
            <li><a href="#" class="hover:text-[#7F00FF]">Actores</a></li>
            <li><a href="#" class="hover:text-[#7F00FF]">Directores</a></li>
            <li><a href="#" class="hover:text-[#7F00FF]">Categorías</a></li>
            <% if (userId) { %>
                <li class="mt-4"><a href="/logout" class="bg-red-600 text-white hover:bg-red-700">Cerrar Sesión</a></li>
            <% } else { %>
                <li class="mt-4"><a href="/login" class="bg-[#7F00FF] text-white hover:bg-[#5800BB]">Iniciar Sesión</a></li>
            <% } %>
        </ul>
    </div>
</div>

<script>
    // Lógica simple para manejar las pestañas (secciones)
    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.tab');
        const sections = {
            'tab-trending': document.getElementById('section-trending'),
            'tab-toprated': document.getElementById('section-toprated'),
            'tab-upcoming': document.getElementById('section-upcoming')
        };

        function showSection(activeId) {
            tabs.forEach(tab => {
                if (tab.id === activeId) {
                    tab.classList.add('tab-active', 'text-[#7F00FF]');
                    tab.classList.remove('text-white');
                } else {
                    tab.classList.remove('tab-active', 'text-[#7F00FF]');
                    tab.classList.add('text-white');
                }
            });

            for (const id in sections) {
                if (id === activeId) {
                    sections[id].classList.remove('hidden');
                } else {
                    sections[id].classList.add('hidden');
                }
            }
        }

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                showSection(tab.id);
            });
        });

        // Inicializar mostrando la sección activa por defecto (trending)
        showSection('tab-trending');
    });
</script>

</body>
</html>